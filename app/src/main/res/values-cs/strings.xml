    <string name="day_starts_at">Den začíná v</string>
    <string name="day_starts_at_explained">Čas po půlnoci a před touto hodinou patří k předchozímu dni, takže dlouhý večer zůstane jedním dnem.</string>
    <string name="count_lock_screen">Počítat probuzení na zamykací obrazovce</string>
    <string name="count_lock_screen_explained">Probuzení, při kterém se displej rozsvítil, ale telefon nebyl odemčen: oznámení, pohled na hodiny. Vypni, pokud chceš počítat jen dobu, kdy byl telefon používán.</string>

