<?xml version="1.0" encoding="utf-8"?>
<!-- The history and the settings travel with a backup and to a new phone; a downloaded
     update does not (it sits in the cache, which is never backed up). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
